<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>CP2K + MACE — панель управления</title>
<style>
  :root {
    --bg: #f4f6f9;
    --card: #ffffff;
    --line: #dfe4ea;
    --ink: #1f2933;
    --muted: #6b7785;
    --accent: #2b6cb0;
    --green: #2f855a;
    --red: #c53030;
    --amber: #b7791f;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font: 14px/1.45 -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  }
  header {
    background: #16222e; color: #e6edf3; padding: 14px 20px;
    display: flex; align-items: baseline; gap: 18px; flex-wrap: wrap;
  }
  header h1 { font-size: 18px; margin: 0; font-weight: 600; }
  header .hint { color: #9fb0c0; font-size: 12px; }
  #statusline { margin-left: auto; font-size: 12px; color: #cbd7e3; display: flex; gap: 14px; }
  nav.tabs { display: flex; gap: 2px; padding: 0 20px; background: #1e2c3a; }
  nav.tabs button {
    background: transparent; border: 0; color: #a9bccd; padding: 10px 16px;
    cursor: pointer; font-size: 14px; border-bottom: 3px solid transparent;
  }
  nav.tabs button.active { color: #fff; border-bottom-color: #63b3ed; }
  main { padding: 18px 20px 60px; max-width: 1500px; margin: 0 auto; }
  section.tab { display: none; }
  section.tab.active { display: block; }
  .grid { display: grid; grid-template-columns: minmax(320px, 1fr) minmax(420px, 1.3fr); gap: 16px; }
  @media (max-width: 1100px) { .grid { grid-template-columns: 1fr; } }
  .card {
    background: var(--card); border: 1px solid var(--line); border-radius: 8px;
    padding: 14px; margin-bottom: 14px;
  }
  .card h2 { font-size: 15px; margin: 0 0 10px; font-weight: 600; }
  .card h3 { font-size: 13px; margin: 14px 0 6px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  label { display: block; font-size: 12px; color: var(--muted); margin-bottom: 3px; }
  input[type=text], input[type=password], input[type=number], select, textarea {
    width: 100%; padding: 7px 9px; border: 1px solid var(--line); border-radius: 5px;
    font: inherit; background: #fff; color: var(--ink);
  }
  textarea { min-height: 62px; resize: vertical; font-family: ui-monospace, Consolas, monospace; font-size: 12px; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; }
  .row > div { flex: 1 1 140px; }
  .actions { margin-top: 10px; display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  button.btn {
    padding: 7px 14px; border-radius: 5px; border: 1px solid transparent; cursor: pointer;
    font: inherit; background: var(--accent); color: #fff;
  }
  button.btn.secondary { background: #edf2f7; color: var(--ink); border-color: var(--line); }
  button.btn.danger { background: var(--red); }
  button.btn:disabled { opacity: .55; cursor: default; }
  .pill { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 11px; font-weight: 600; }
  .pill.ok { background: #e6fffa; color: var(--green); }
  .pill.off { background: #edf2f7; color: var(--muted); }
  .pill.err { background: #fff5f5; color: var(--red); }
  .pill.warn { background: #fffaf0; color: var(--amber); }
  .mono { font-family: ui-monospace, Consolas, monospace; font-size: 12px; }
  .log {
    background: #0f1720; color: #d5e2ee; font-family: ui-monospace, Consolas, monospace;
    font-size: 12px; line-height: 1.4; padding: 10px; border-radius: 6px;
    height: 420px; overflow: auto; white-space: pre-wrap; word-break: break-word; margin: 0;
  }
  .log.short { height: 240px; }
  table.tbl { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  table.tbl th, table.tbl td { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); }
  table.tbl th { color: var(--muted); font-weight: 600; font-size: 11px; text-transform: uppercase; }
  table.tbl td.num { text-align: right; font-family: ui-monospace, Consolas, monospace; }
  .proc { border: 1px solid var(--line); border-radius: 6px; padding: 10px; margin-bottom: 10px; }
  .proc .head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 6px; }
  .proc .head b { font-size: 13px; }
  .kv { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 12px; color: var(--muted); }
  .kv code { color: var(--ink); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    background: #edf2f7; border-radius: 999px; padding: 2px 8px; font-size: 12px;
    display: inline-flex; gap: 6px; align-items: center;
  }
  .chip button { border: 0; background: transparent; cursor: pointer; color: var(--red); font-weight: 700; }
  .checks { display: flex; flex-direction: column; gap: 4px; max-height: 150px; overflow: auto; }
  .checks label { display: flex; gap: 8px; align-items: center; font-size: 12.5px; color: var(--ink); margin: 0; }
  .check-row { display: flex; align-items: center; gap: 4px; }
  .check-row label { flex: 1 1 auto; min-width: 0; }
  .icon-btn {
    border: 1px solid var(--line); background: #fff; color: var(--muted);
    border-radius: 4px; cursor: pointer; font-size: 12px; line-height: 1;
    padding: 4px 6px;
  }
  .icon-btn:hover { color: var(--red); border-color: var(--red); }
  .muted { color: var(--muted); font-size: 12px; }
  .err { color: var(--red); font-size: 12.5px; white-space: pre-wrap; }
  .ok { color: var(--green); font-size: 12.5px; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 1000px) { .split { grid-template-columns: 1fr; } }
  details.card > summary {
    cursor: pointer; font-size: 15px; font-weight: 600; list-style: none;
  }
  details.card > summary::-webkit-details-marker { display: none; }
  details.card > summary::before { content: '▸ '; color: var(--accent); }
  details.card[open] > summary::before { content: '▾ '; }
  details.card > summary .muted { font-weight: 400; font-size: 12px; }
  .cfg-form { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 16px; }
  @media (max-width: 900px) { .cfg-form { grid-template-columns: 1fr; } }
  .cfg-field label { font-family: ui-monospace, Consolas, monospace; font-size: 12px; color: var(--ink); }
  .cfg-field .muted { margin-top: 2px; font-size: 11.5px; }
  .cfg-field.wide { grid-column: 1 / -1; }
  .cfg-bool { display: flex; gap: 8px; align-items: center; font-size: 13px; }
  tr.tx-row { cursor: pointer; }
  tr.tx-row:hover { background: #f7fafc; }
  details summary { cursor: pointer; color: var(--accent); font-size: 12.5px; }
</style>
</head>
<body>

<header>
  <h1>CP2K + MACE</h1>
  <span class="hint">мастер · воркер · MACE · кошельки — в одном окне</span>
  <div id="statusline">
    <span id="st-masters">мастеров: —</span>
    <span id="st-workers">воркеров: —</span>
    <span id="st-height">высота: —</span>
  </div>
</header>

<nav class="tabs">
  <button data-tab="master" class="active">Мастер</button>
  <button data-tab="worker">Воркер</button>
  <button data-tab="mace">MACE</button>
  <button data-tab="wallet1">Кошелёк 1</button>
  <button data-tab="wallet2">Кошелёк 2</button>
</nav>

<main>

<!-- ==================== МАСТЕР ==================== -->
<section class="tab active" id="tab-master">
  <div class="grid">
    <div>
      <div class="card">
        <h2>Запустить мастера</h2>
        <p class="muted" style="margin-top:-4px">
          Пустые порт и папка — «авто»: панель сама найдёт свободный порт (с 8000)
          и отдельный каталог результатов, чтобы мастера не конфликтовали.
        </p>
        <div class="row">
          <div>
            <label>Порт (пусто = авто)</label>
            <input type="number" id="m-port" placeholder="авто" min="1" max="65535" />
          </div>
          <div>
            <label>Каталог результатов (пусто = авто)</label>
            <input type="text" id="m-dir" placeholder="results" />
          </div>
          <div>
            <label>Пароль кошелька</label>
            <input type="password" id="m-password" value="master" />
          </div>
        </div>
        <div style="margin-top:10px">
          <label>Пиры (по одному URL в строке, необязательно)</label>
          <textarea id="m-peers" placeholder="http://127.0.0.1:8001"></textarea>
        </div>
        <div class="actions">
          <button class="btn" id="btn-master-start">Запустить мастера</button>
          <span id="m-msg" class="muted"></span>
        </div>
      </div>

      <details class="card" id="cfg-master-box">
        <summary><b>Настройки</b> <span class="muted">src/config.json — параметры мастера</span></summary>
        <p class="muted" style="margin:8px 0 10px">
          Файл общий для мастера и воркера. Изменения применяются к <b>следующему</b>
          запуску; у уже работающего мастера — через <code>master-cli.py config set</code>.
        </p>
        <div id="cfg-master" class="cfg-form"><span class="muted">откройте блок, чтобы прочитать</span></div>
        <div class="actions">
          <button class="btn" id="cfg-master-save">Сохранить</button>
          <button class="btn secondary" id="cfg-master-reload">Перечитать</button>
          <span class="muted" id="cfg-master-msg"></span>
        </div>
      </details>

      <div class="card">
        <h2>Мастера</h2>
        <div id="master-list" class="muted">пока никто не следит за очередью…</div>
      </div>
    </div>

    <div>
      <div class="card">
        <h2>Лог мастера</h2>
        <div class="row" style="margin-bottom:8px">
          <div>
            <select id="master-log-select"></select>
          </div>
          <div style="flex:0 0 auto">
            <button class="btn secondary" id="master-log-refresh">Обновить</button>
          </div>
        </div>
        <pre class="log" id="master-log"></pre>
      </div>
    </div>
  </div>
</section>

<!-- ==================== ВОРКЕР ==================== -->
<section class="tab" id="tab-worker">
  <div class="grid">
    <div>
      <div class="card">
        <h2>Запустить воркера</h2>
        <div class="row">
          <div>
            <label>Имя (имя кошелька)</label>
            <input type="text" id="w-name" placeholder="авто: worker1, worker2…" />
          </div>
          <div>
            <label>Пароль кошелька</label>
            <input type="password" id="w-password" value="worker" />
          </div>
        </div>

        <h3>Адреса мастеров в сети</h3>
        <p class="muted" style="margin:2px 0 6px">
          Список строится из мастеров этой панели и адресов, которые мастер
          сообщает воркеру (его пиры). Отметьте нужные — они уйдут воркеру.
        </p>
        <div class="checks" id="w-master-checks"></div>
        <div style="margin-top:8px">
          <label>Добавить адрес вручную</label>
          <div class="row">
            <div><input type="text" id="w-manual" placeholder="http://192.168.1.10:8000" /></div>
            <div style="flex:0 0 auto"><button class="btn secondary" id="w-add-manual">Добавить</button></div>
          </div>
        </div>

        <div class="actions">
          <button class="btn" id="btn-worker-start">Запустить воркера</button>
          <span id="w-msg" class="muted"></span>
        </div>
      </div>

      <details class="card" id="cfg-worker-box">
        <summary><b>Настройки</b> <span class="muted">что воркер получает от мастера</span></summary>
        <p class="muted" style="margin:8px 0 10px">
          Воркер не читает файлы сам: мастер передаёт ему эти значения в задании.
          Остальные параметры (очередь, кошелёк, блокчейн) — во вкладке «Мастер».
        </p>
        <div id="cfg-worker" class="cfg-form"><span class="muted">откройте блок, чтобы прочитать</span></div>
        <div class="actions">
          <button class="btn" id="cfg-worker-save">Сохранить</button>
          <button class="btn secondary" id="cfg-worker-reload">Перечитать</button>
          <span class="muted" id="cfg-worker-msg"></span>
        </div>
      </details>

      <div class="card">
        <h2>Воркеры</h2>
        <div id="worker-list" class="muted">ни одного воркера…</div>
      </div>
    </div>

    <div>
      <div class="card">
        <h2>Лог воркера</h2>
        <div class="row" style="margin-bottom:8px">
          <div><select id="worker-log-select"></select></div>
          <div style="flex:0 0 auto"><button class="btn secondary" id="worker-log-refresh">Обновить</button></div>
        </div>
        <pre class="log" id="worker-log"></pre>
      </div>

      <div class="card">
        <h2>Лог CP2K</h2>
        <div class="row" style="margin-bottom:8px">
          <div><select id="cp2k-dir"></select></div>
          <div style="flex:0 0 auto"><button class="btn secondary" id="cp2k-refresh">Обновить</button></div>
        </div>
        <div class="muted" id="cp2k-file" style="margin-bottom:6px">файл не выбран</div>
        <pre class="log short" id="cp2k-log"></pre>
      </div>
    </div>
  </div>
</section>

<!-- ==================== MACE ==================== -->
<section class="tab" id="tab-mace">
  <div class="grid">
    <div>
      <div class="card">
        <h2>MACE-пайплайн</h2>
        <p class="muted" style="margin-top:-4px">
          Блокчейн → train.xyz → обучение MACE → поиск минимума → HTML-отчёт.
          Без интернета обучение с foundation_model недоступно; используйте
          <code>--skip-train</code> с готовой моделью.
        </p>
        <div class="row">
          <div>
            <label>Элемент</label>
            <input type="text" id="mace-element" placeholder="Cu" />
          </div>
          <div>
            <label>Каталог результатов</label>
            <select id="mace-dir"></select>
          </div>
        </div>
        <div class="row" style="margin-top:10px">
          <div>
            <label>Готовая модель (.model, необязательно)</label>
            <input type="text" id="mace-model" placeholder="/workspace/mace_pipeline/out/model.model" />
          </div>
          <div>
            <label>Каталог вывода (необязательно)</label>
            <input type="text" id="mace-out" placeholder="mace_pipeline/out" />
          </div>
        </div>
        <div class="actions">
          <label style="display:flex;gap:6px;align-items:center;margin:0">
            <input type="checkbox" id="mace-skip-train" /> пропустить обучение
          </label>
          <label style="display:flex;gap:6px;align-items:center;margin:0">
            <input type="checkbox" id="mace-skip-search" /> пропустить поиск минимума
          </label>
        </div>
        <div class="actions">
          <button class="btn" id="btn-mace-start">Запустить MACE</button>
          <span id="mace-msg" class="muted"></span>
        </div>
      </div>
    </div>
    <div>
      <div class="card">
        <h2>Лог MACE</h2>
        <div class="row" style="margin-bottom:8px">
          <div><select id="mace-log-select"></select></div>
          <div style="flex:0 0 auto"><button class="btn secondary" id="mace-log-refresh">Обновить</button></div>
        </div>
        <pre class="log" id="mace-log"></pre>
      </div>
    </div>
  </div>
</section>

<!-- ==================== КОШЕЛЬКИ ==================== -->
<section class="tab" id="tab-wallet1"></section>
<section class="tab" id="tab-wallet2"></section>

</main>

<script>
/* ==================== общее ==================== */

const $ = (sel, root) => (root || document).querySelector(sel);
const $$ = (sel, root) => Array.from((root || document).querySelectorAll(sel));

function esc(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');
}

async function api(url, body) {
  const opts = body === undefined ? {} : {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify(body),
  };
  try {
    const r = await fetch(url, opts);
    const data = await r.json();
    return data;
  } catch (e) {
    return { ok: false, error: String(e) };
  }
}

let overview = { processes: [], masters: [], dirs: [] };
let network = [];
let activeTab = 'master';

/* ==================== вкладки ==================== */

$$('nav.tabs button').forEach((btn) => {
  btn.addEventListener('click', () => {
    activeTab = btn.dataset.tab;
    $$('nav.tabs button').forEach((b) => b.classList.toggle('active', b === btn));
    $$('section.tab').forEach((s) => s.classList.toggle('active', s.id === 'tab-' + activeTab));
    if (activeTab === 'worker') { refreshNetwork(); refreshCp2k(); }
    if (activeTab.startsWith('wallet')) refreshWallet(activeTab);
  });
});

/* ==================== обзор ==================== */

async function refreshOverview() {
  const data = await api('/api/overview');
  if (!data.ok) return;
  overview = data;

  const masters = data.processes.filter((p) => p.kind === 'master');
  const workers = data.processes.filter((p) => p.kind === 'worker');
  const mace = data.processes.filter((p) => p.kind === 'mace');

  const aliveMasters = data.masters.length + (data.external || []).length;
  const aliveWorkers = workers.filter((p) => p.alive).length;
  const topHeight = Math.max(
    data.masters.reduce((m, p) => Math.max(m, (p.info && p.info.height) || 0), 0),
    (data.external || []).reduce((m, p) => Math.max(m, p.height || 0), 0));
  $('#st-masters').textContent = 'мастеров: ' + aliveMasters;
  $('#st-workers').textContent = 'воркеров: ' + aliveWorkers;
  $('#st-height').textContent = 'высота: ' + topHeight;

  renderMasters(masters, data.masters, data.external || []);
  renderWorkers(workers);
  renderMace(mace);
  fillDirSelects(data.dirs);
  refreshLogSelects(masters, workers, mace);
}

function fillDirSelects(dirs) {
  const mk = (sel, keepDefault) => {
    const el = $(sel);
    if (!el) return;
    const cur = el.value;
    el.innerHTML = (keepDefault ? '<option value="">по умолчанию (results)</option>' : '')
      + dirs.map((d) => `<option value="${esc(d)}">${esc(String(d).replace((overview.root || '') + '/', ''))}</option>`).join('');
    if (cur) el.value = cur;
  };
  mk('#cp2k-dir', false);
  mk('#mace-dir', true);
  if (!dirs.length) {
    $('#cp2k-dir').innerHTML = '<option value="">results</option>';
  }
  fillWalletRoots(dirs);
}

function renderMasters(all, alive, external) {
  const box = $('#master-list');
  if (!all.length && !(external && external.length)) {
    box.innerHTML = '<span class="muted">мастеров нет</span>';
    return;
  }
  const externCards = (external || []).map((e) => `
    <div class="proc">
      <div class="head">
        <b>мастер :${e.port}</b> <span class="pill warn">запущен вне панели</span>
        <span class="mono muted">${esc(e.url)}</span>
      </div>
      <div class="kv">
        <span>элемент <code>${esc(e.element)}</code></span>
        <span>высота <code>${e.height == null ? '—' : e.height}</code></span>
        <span>очередь <code>${e.pending == null ? '—' : e.pending}</code></span>
        <span>в работе <code>${e.active == null ? '—' : e.active}</code></span>
      </div>
      ${(e.peers || []).length ? `<div class="chips" style="margin-top:6px">
        ${e.peers.map((u) => `<span class="chip">${esc(u)}</span>`).join('')}</div>` : ''}
      <div class="actions">
        <span class="muted">остановить можно только из терминала</span>
      </div>
    </div>`).join('');

  box.innerHTML = externCards + all.map((p) => {
    const info = (alive.find((a) => a.id === p.id) || {}).info || null;
    const status = p.alive
      ? (info && info.reachable ? '<span class="pill ok">работает</span>' : '<span class="pill warn">запускается…</span>')
      : '<span class="pill off">остановлен</span>';
    const peers = (info && info.peers) || p.peers || [];
    const peerChips = peers.map((u) => `<span class="chip">${esc(u)}<button data-peer-del="${esc(u)}" data-port="${p.port}" title="удалить пир">×</button></span>`).join('')
      || '<span class="muted">пиров нет</span>';
    return `
      <div class="proc">
        <div class="head">
          <b>${esc(p.name)}</b> ${status}
          <span class="mono muted">pid ${p.pid || '—'}</span>
        </div>
        <div class="kv">
          <span>порт <code>${p.port || '—'}</code></span>
          <span>папка <code>${esc((p.dir || '').replace(overview.root + '/', ''))}</code></span>
          ${info ? `<span>высота <code>${info.height == null ? '—' : info.height}</code></span>
          <span>очередь <code>${info.pending == null ? '—' : info.pending}</code></span>
          <span>в работе <code>${info.active == null ? '—' : info.active}</code></span>
          <span>воркеров <code>${info.workers == null ? '—' : info.workers}</code></span>` : ''}
        </div>
        <h3>Пиры (их увидит воркер)</h3>
        <div class="chips">${peerChips}</div>
        <div class="row" style="margin-top:8px">
          <div><input type="text" placeholder="http://192.168.1.10:8000" data-peer-input="${p.port}" /></div>
          <div style="flex:0 0 auto"><button class="btn secondary" data-peer-add="${p.port}">Добавить</button></div>
        </div>
        <div class="actions">
          <button class="btn secondary" data-show-log="${p.id}" data-kind="master">Лог</button>
          ${p.alive ? `<button class="btn danger" data-stop="${p.id}">Остановить</button>` : ''}
        </div>
      </div>`;
  }).join('');

  $$('[data-stop]', box).forEach((b) => b.addEventListener('click', async () => {
    if (!confirm('Остановить процесс?')) return;
    const r = await api('/api/process/stop', { id: b.dataset.stop });
    if (!r.ok) alert(r.error);
    refreshOverview();
  }));
  $$('[data-show-log]', box).forEach((b) => b.addEventListener('click', () => {
    if (b.dataset.kind === 'master') showLog('master', b.dataset.showLog);
  }));
  $$('[data-peer-add]', box).forEach((b) => b.addEventListener('click', async () => {
    const port = b.dataset.peerAdd;
    const input = $(`[data-peer-input="${port}"]`);
    const url = (input.value || '').trim();
    if (!url) return;
    const r = await api('/api/master/peers', { port, action: 'add', url });
    if (!r.ok) alert(r.error); else input.value = '';
    refreshOverview();
  }));
  $$('[data-peer-del]', box).forEach((b) => b.addEventListener('click', async () => {
    const r = await api('/api/master/peers', { port: b.dataset.port, action: 'del', url: b.dataset.peerDel });
    if (!r.ok) alert(r.error);
    refreshOverview();
  }));
}

