  const isMaster = tab === 'wallet1';
  el.innerHTML = `
    <div class="grid">
      <div>
        <div class="card">
          <h2>${isMaster ? 'Кошелёк мастера' : 'Кошелёк воркера'}
            <span class="muted" style="font-weight:400;font-size:12px">роль: ${isMaster ? 'master' : 'worker'}</span></h2>
          <p class="muted" style="margin-top:-4px">
            Пароль определяет, чей кошелёк открыть: <code>master</code> — мастер,
            <code>worker</code> — воркеры. Кошельки лежат в общей базе выбранного
