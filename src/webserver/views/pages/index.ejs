/* ==================== логи ==================== */

const logs = {
  master: { id: null, offset: 0 },
  worker: { id: null, offset: 0 },
  mace: { id: null, offset: 0 },
};

function refreshLogSelects(masters, workers, mace) {
  const fill = (sel, list, kind) => {
    const el = $(sel);
    if (!el) return;
    const cur = logs[kind].id;
    el.innerHTML = list.length
      ? list.map((p) => `<option value="${p.id}">${esc(p.name)}${p.alive ? '' : ' (остановлен)'}</option>`).join('')
      : '<option value="">—</option>';
    if (cur && list.some((p) => p.id === cur)) el.value = cur;
    else if (list.length) logs[kind].id = list[0].id;
  };
  fill('#master-log-select', masters, 'master');
  fill('#worker-log-select', workers, 'worker');
  fill('#mace-log-select', mace, 'mace');

  $$('#master-log-select,#worker-log-select,#mace-log-select').forEach((el) => {
    if (el.dataset.bound) return;
    el.dataset.bound = '1';
    el.addEventListener('change', () => {
      const kind = el.id.split('-')[0];
      logs[kind].id = el.value;
      logs[kind].offset = 0;
      $('#' + kind + '-log').textContent = '';
      pollLog(kind);
    });
  });
}

function showLog(kind, id) {
  logs[kind].id = id;
  logs[kind].offset = 0;
  const sel = $('#' + kind + '-log-select');
  if (sel) sel.value = id;
  $('#' + kind + '-log').textContent = '';
  pollLog(kind);
}

async function pollLog(kind) {
  const state = logs[kind];
  const pre = $('#' + kind + '-log');
  if (!pre || !state.id) return;
  const data = await api(`/api/process/log?id=${encodeURIComponent(state.id)}&offset=${state.offset}`);
  if (!data.ok) return;
  if (data.offset < state.offset) pre.textContent = '';
  if (data.chunk) pre.textContent += data.chunk;
  state.offset = data.offset;
  pre.scrollTop = pre.scrollHeight;
}

setInterval(() => {
  if (activeTab === 'master') pollLog('master');
  if (activeTab === 'worker') pollLog('worker');
  if (activeTab === 'mace') pollLog('mace');
}, 1500);

setInterval(refreshOverview, 4000);

$('#master-log-refresh').addEventListener('click', () => pollLog('master'));
$('#worker-log-refresh').addEventListener('click', () => pollLog('worker'));
$('#mace-log-refresh').addEventListener('click', () => pollLog('mace'));

