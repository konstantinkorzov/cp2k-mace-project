async function refreshNetwork() {
  const data = await api('/api/network');
  if (!data.ok) return;
  network = data.nodes || [];
  renderNetwork();
}

function renderNetwork() {
  const box = $('#w-master-checks');
  if (!network.length) {
    box.innerHTML = '<span class="muted">мастеров пока нет — запустите мастера на вкладке «Мастер»</span>';
    return;
  }
  const chosen = new Set(Array.from(box.querySelectorAll('input:checked')).map((i) => i.value));
  box.innerHTML = network.map((n) => `
    <div class="check-row">
      <label>
        <input type="checkbox" value="${esc(n.url)}" ${chosen.has(n.url) ? 'checked' : ''} />
        <span class="mono">${esc(n.url)}</span>
        <span class="pill ${n.ok ? 'ok' : 'off'}">${n.ok ? 'высота ' + (n.height == null ? '?' : n.height) : 'недоступен'}</span>
        <span class="muted">${esc(n.source || '')}</span>
      </label>
      ${n.manual ? `<button class="icon-btn" data-edit="${esc(n.url)}" title="изменить адрес">✎</button>
      <button class="icon-btn" data-del="${esc(n.url)}" title="убрать из списка">×</button>` : ''}
    </div>`).join('');

  $$('[data-del]', box).forEach((b) => b.addEventListener('click', (ev) => {
    ev.preventDefault();
    network = network.filter((n) => n.url !== b.dataset.del);
    renderNetwork();
  }));
  $$('[data-edit]', box).forEach((b) => b.addEventListener('click', (ev) => {
    ev.preventDefault();
    const next = prompt('Новый адрес мастера', b.dataset.edit);
    if (!next) return;
    const url = next.trim();
    if (!url) return;
    const node = network.find((n) => n.url === b.dataset.edit);
    if (node) { node.url = url; node.ok = true; node.height = null; }
    renderNetwork();
  }));
}

$('#w-add-manual').addEventListener('click', () => {
  const url = ($('#w-manual').value || '').trim();
  if (!url) return;
  if (!network.some((n) => n.url === url)) {
    network.push({ url, ok: true, height: null, source: 'вручную', manual: true });
  }
  $('#w-manual').value = '';
  renderNetwork();
});

