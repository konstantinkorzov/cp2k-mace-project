async function refreshCp2k() {
  const dir = $('#cp2k-dir').value || '';
  const data = await api('/api/cp2k/log?dir=' + encodeURIComponent(dir) + '&tail=40000');
  const pre = $('#cp2k-log');
  if (!data.ok) { $('#cp2k-file').textContent = data.error || 'нет данных'; return; }
  if (!data.file) { $('#cp2k-file').textContent = 'в этом каталоге нет .out — расчёт ещё не начинался'; pre.textContent = ''; return; }
  $('#cp2k-file').textContent = data.file + '  ·  ' + Math.round(data.size / 1024) + ' КБ'
    + (data.truncated ? '  ·  показан конец файла' : '');
  pre.textContent = data.content;
  pre.scrollTop = pre.scrollHeight;
}

