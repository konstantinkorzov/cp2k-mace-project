async function refreshWalletNames(ids, root) {
  const data = await api('/api/wallet/list', { resultsRoot: root || null });
  const list = (data && data.ok && data.wallets) ? data.wallets : [];
  for (const id of ids) {
    const sel = document.getElementById(id);
    if (!sel) continue;
    const cur = sel.value;
    sel.innerHTML = list.length
      ? list.map((w) => `<option value="${esc(w.name)}">${esc(w.name)} · ${w.keys} адр.</option>`).join('')
      : '<option value="">кошельков нет</option>';
    if (cur && list.some((w) => w.name === cur)) sel.value = cur;
  }
  if (ids.includes('wal-name') && !walletState) {
    const box = document.getElementById('wal-content');
    if (box) {
      box.innerHTML = list.length
        ? '<span class="muted">выберите кошелёк и нажмите «Открыть»</span>'
        : '<span class="muted">кошельков пока нет — создайте первый в блоке «Создать кошелёк»</span>';
    }
  }
  return list;
}

async function openWallet() {
  const name = document.getElementById('wal-name').value;
  const password = document.getElementById('wal-password').value;
  const msg = document.getElementById('wal-msg');
  if (!name) { msg.innerHTML = '<span class="err">сначала создайте кошелёк</span>'; return; }
  msg.textContent = 'читаю…';
  const data = await api('/api/wallet/info', {
    name, password,
    resultsRoot: document.getElementById('wal-root').value || null,
    element: document.getElementById('wal-chain').value || null,
    masters: walletMasters(),
  });
  if (!data.ok) {
    walletState = null;
    document.getElementById('wal-send-card').style.display = 'none';
    document.getElementById('wal-content').innerHTML = '<span class="muted">кошелёк не открыт</span>';
    msg.innerHTML = `<span class="err">${esc(data.error || 'ошибка')}</span>`;
    return;
  }
  walletState = data;
  document.getElementById('wal-send-card').style.display = 'block';
  if (data.chains) applyChains(data.chains, data.element);
  renderWallet(data);
  msg.innerHTML = walletStatus(data);
}

async function createWallet() {
  const name = document.getElementById('wal-new-name').value.trim();
  const password = document.getElementById('wal-new-pass').value;
  const box = document.getElementById('wal-create-msg');
  if (!name) { box.innerHTML = '<span class="err">нужно имя кошелька</span>'; return; }
  if (password.length < 4) { box.innerHTML = '<span class="err">пароль короче 4 символов</span>'; return; }
  box.textContent = 'создаю…';
  const r = await api('/api/wallet/create', {
    name, password,
    resultsRoot: document.getElementById('wal-root').value || null,
  });
  if (!r.ok) {
    box.innerHTML = `<span class="err">${esc(r.error || 'не удалось создать')}</span>`;
    return;
  }
  box.innerHTML = `<span class="ok">кошелёк «${esc(r.name)}» создан, адрес ${esc(String(r.address).slice(0, 16))}…</span>`;
  document.getElementById('wal-new-name').value = '';
  document.getElementById('wal-new-pass').value = '';
  await refreshWalletNames(['wal-name', 'm-wallet', 'w-wallet'],
                           document.getElementById('wal-root').value || null);
  document.getElementById('wal-name').value = r.name;
  document.getElementById('wal-password').value = password;
  openWallet();
}

function walletStatus(data) {
  return `<span class="ok">${esc(data.wallet.name)} · ${esc(data.element)} · высота ${data.height}</span>`
    + ` <span class="muted">мастеров: ${(data.masters || []).length},`
    + ` в мемпуле: ${data.mempool_count || 0},`
    + ` адресов: ${data.wallet ? data.wallet.addresses.length : 0}</span>`;
}

function renderWallet(data) {
  const box = document.getElementById('wal-content');
  const w = data.wallet;
  if (!w) {
    box.innerHTML = '<span class="muted">адресов нет</span>';
    return;
  }
  const addrs = (w.addresses || []).map((a) => `
    <div class="mono muted" style="font-size:11.5px">${esc(a.address)}</div>`).join('');
  const txs = (w.transactions || []).slice()
    .sort((a, b) => {
      if (Boolean(a.mempool) !== Boolean(b.mempool)) return a.mempool ? -1 : 1;
      return (b.block || 0) - (a.block || 0);
    })
    .map((t) => {
      const pending = Boolean(t.mempool);
      const net = (t.received || 0) - (t.sent || 0);
      const amount = (net >= 0 ? '+' : '−') + Math.abs(net);
      const cls = net > 0 ? 'ok' : (net < 0 ? 'err' : '');
      const hint = (t.received && t.sent)
        ? `приход ${t.received}, расход ${t.sent} — нажмите для деталей`
        : 'нажмите, чтобы посмотреть входы и выходы';
      return `<tr class="tx-row" data-txid="${esc(t.txid)}" title="${esc(hint)}">
        <td class="num">${pending ? '<span class="pill warn">мемпул</span>' : t.block}</td>
        <td>${esc(t.type)}</td>
        <td class="num ${cls}">${amount}</td>
        <td class="num">${t.fee || '—'}</td>
        <td class="num">${pending ? 0 : t.confirmations}</td>
        <td class="mono" title="${esc(t.txid)}">${esc(t.txid.slice(0, 12))}…</td>
      </tr>`;
    }).join('');

  box.innerHTML = `
    <div class="proc">
      <div class="head">
        <b>${esc(w.name)}</b>
        <span class="mono muted">${esc(data.element)}</span>
        <span class="muted">адресов: ${w.addresses.length}</span>
        <button class="btn secondary" style="margin-left:auto;padding:4px 10px;font-size:12px"
                data-newkey="1">＋ адрес</button>
        <span class="pill ok">доступно ${w.totals.available.toFixed(2)}</span>
        <span class="pill warn">pending ${w.totals.pending.toFixed(2)}</span>
        <span class="pill off">всего ${w.totals.total.toFixed(2)}</span>
      </div>
      <h3>Адреса</h3>
      ${addrs || '<span class="muted">нет</span>'}
      <h3>Транзакции</h3>
      ${txs ? `<table class="tbl">
        <thead><tr><th>Блок</th><th>Тип</th><th>Сумма</th><th>Комиссия</th>
        <th>Подтв.</th><th>Txid</th></tr></thead>
        <tbody>${txs}</tbody></table>`
      : '<span class="muted">транзакций пока нет</span>'}
    </div>`;
}

function shortAddr(a) {
  if (!a) return '—';
  return a.length > 20 ? a.slice(0, 10) + '…' + a.slice(-6) : a;
}

async function showTxDetails(txid) {
  const card = document.getElementById('wal-tx-card');
  const box = document.getElementById('wal-tx');
  card.style.display = 'block';
  box.innerHTML = '<span class="muted">читаю блок…</span>';
  card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

  const data = await api('/api/wallet/tx', {
    txid, resultsRoot: document.getElementById('wal-root').value || null,
    element: document.getElementById('wal-chain').value || null,
    masters: walletMasters(),
  });
  if (!data.ok) {
    box.innerHTML = `<span class="err">${esc(data.error || 'не читается')}</span>`;
    return;
  }

  const ins = (data.inputs || []).map((i) => i.coinbase
    ? '<div class="mono">− coinbase: новых монет (без источника)</div>'
    : `<div class="mono">− ${i.value == null ? '?' : i.value.toFixed(6)}
        с ${esc(shortAddr(i.address))}
        ${i.txid ? `<span class="muted">(${esc(String(i.txid).slice(0, 10))}…#${i.vout})</span>` : ''}</div>`)
    .join('');

  const outs = (data.outputs || []).map((o) =>
    `<div class="mono">+ ${o.value} на ${esc(shortAddr(o.address))}</div>`).join('');

  box.innerHTML = `
    <div class="kv">
      ${data.block != null ? `<span>блок <code>${data.block}</code></span>`
        : '<span class="pill warn">в мемпуле</span>'}
      <span>подтверждений <code>${data.confirmations}</code></span>
      <span>тип <code>${esc(data.type)}</code></span>
      ${data.fee != null ? `<span>комиссия <code>${data.fee}</code></span>` : ''}
    </div>
    <div class="mono muted" style="font-size:11px;margin:6px 0">${esc(data.txid)}</div>
    <h3>Откуда — входы (${data.total_in})</h3>
    ${ins || '<span class="muted">нет входов</span>'}
    <h3>Куда — выходы (${data.total_out})</h3>
    ${outs || '<span class="muted">нет выходов</span>'}
    <div class="actions">
      <button class="btn secondary" id="wal-raw-btn">Полная транзакция из блока</button>
      <button class="btn secondary" id="wal-close">Закрыть</button>
    </div>
    <pre class="log short" id="wal-raw" style="display:none">${esc(JSON.stringify(data.raw, null, 2))}</pre>`;

  const raw = document.getElementById('wal-raw');
  document.getElementById('wal-raw-btn').addEventListener('click', () => {
    raw.style.display = raw.style.display === 'none' ? 'block' : 'none';
  });
  document.getElementById('wal-close').addEventListener('click', () => {
    card.style.display = 'none';
  });
}

async function refreshWallet() {
  if (!walletState) return;
  const data = await api('/api/wallet/info', {
    name: document.getElementById('wal-name').value,
    password: document.getElementById('wal-password').value,
    resultsRoot: document.getElementById('wal-root').value || null,
    element: document.getElementById('wal-chain').value || null,
    masters: walletMasters(),
  });
  const msg = document.getElementById('wal-msg');
  if (!data.ok) {
    // Пароль сменили (или каталог другой) — прежний кошелёк больше не открыт.
    walletState = null;
    document.getElementById('wal-send-card').style.display = 'none';
    document.getElementById('wal-content').innerHTML = '<span class="muted">кошелёк не открыт</span>';
    if (msg) msg.innerHTML = `<span class="err">${esc(data.error || 'ошибка')}</span>`;
    return;
  }
  walletState = data;
  if (data.chains) applyChains(data.chains, data.element);
  renderWallet(data);
  if (msg) {
    msg.innerHTML = walletStatus(data)
      + ` <span class="muted">· обновлено ${new Date().toLocaleTimeString('ru-RU')}</span>`;
  }
}

async function newAddress() {
  const name = document.getElementById('wal-name').value;
  const password = document.getElementById('wal-password').value;
  const msg = document.getElementById('wal-msg');
  if (!name) { msg.innerHTML = '<span class="err">сначала создайте кошелёк</span>'; return; }
  msg.textContent = 'генерирую адрес…';
  const r = await api('/api/wallet/newkey', {
    name, password,
    resultsRoot: document.getElementById('wal-root').value || null,
  });
  if (r.ok) {
    msg.innerHTML = `<span class="ok">новый адрес: <span class="mono">${esc(r.address)}</span></span>`;
    refreshWallet();
  } else {
    msg.innerHTML = `<span class="err">${esc(r.error || 'не удалось создать адрес')}</span>`;
  }
}

async function changePassword() {
  const name = document.getElementById('wal-name').value;
  const password = document.getElementById('wal-password').value;
  const newPassword = document.getElementById('wal-newpass').value;
  const msg = document.getElementById('wal-msg');
  if (!name) { msg.innerHTML = '<span class="err">сначала выберите кошелёк</span>'; return; }
  if (!newPassword) return;
  const r = await api('/api/wallet/passwd', {
    name, password, newPassword,
    resultsRoot: document.getElementById('wal-root').value || null,
  });
  msg.innerHTML = r.ok
    ? `<span class="ok">пароль кошелька «${esc(r.name)}» изменён — обновите поле пароля</span>`
    : `<span class="err">${esc(r.error)}</span>`;
}

async function sendCoins() {
  const name = document.getElementById('wal-name').value;
  const password = document.getElementById('wal-password').value;
  const msg = document.getElementById('wal-send-msg');
  const to = document.getElementById('wal-to').value.trim();
  const amount = Number(document.getElementById('wal-amount').value);
  const fee = Number(document.getElementById('wal-fee').value || 0);
  if (!name) { msg.innerHTML = '<span class="err">сначала выберите кошелёк</span>'; return; }
  if (!to || !(amount > 0)) { msg.innerHTML = '<span class="err">нужны адрес и сумма</span>'; return; }
  msg.textContent = 'отправляю…';
  const r = await api('/api/wallet/send', {
    name, password, to, amount, fee,
    resultsRoot: document.getElementById('wal-root').value || null,
    element: document.getElementById('wal-chain').value || null,
    masters: walletMasters(),
  });
  msg.innerHTML = r.ok
    ? `<span class="ok">принята мастерами: ${esc((r.accepted_by || []).join(', '))}</span>`
    : `<span class="err">${esc(r.error || 'не принята')}</span>`;
  if (r.ok) refreshWallet();
}

function blocksWord(n) {
  const a = Math.abs(n) % 100, b = a % 10;
  if (a > 10 && a < 20) return 'блоков';
  if (b === 1) return 'блок';
  if (b >= 2 && b <= 4) return 'блока';
  return 'блоков';
}

async function refreshChains() {
  const sel = document.getElementById('wal-chain');
  if (!sel) return;
  const data = await api('/api/wallet/chains', {
    resultsRoot: document.getElementById('wal-root').value || null,
  });
  if (!data.ok) {
    sel.innerHTML = '<option value="">нет цепочек</option>';
    return;
  }
  applyChains(data.chains || [], data.element);
}

function applyChains(chains, current) {
  const sel = document.getElementById('wal-chain');
  if (!sel) return;
  const keep = sel.value || current || '';
  sel.innerHTML = (chains || []).map((c) =>
    `<option value="${esc(c.name)}">${esc(c.name)} — ${c.height} ${blocksWord(c.height)}</option>`)
    .join('') || '<option value="">нет цепочек</option>';
  if (keep && [...sel.options].some((o) => o.value === keep)) sel.value = keep;
}

function walletMasters() {
  const urls = [
    ...overview.masters.map((m) => `http://127.0.0.1:${m.port}`),
    ...(overview.external || []).map((e) => e.url),
    ...network.map((n) => n.url),
  ];
  return [...new Set(urls.map((u) => String(u).replace(/\/+$/, '')).filter(Boolean))];
}

function fillWalletRoots(dirs) {
  const sel = document.getElementById('wal-root');
  if (sel) {
    const cur = sel.value;
    sel.innerHTML = dirs.map((d) =>
      `<option value="${esc(d)}">${esc(d.replace(overview.root + '/', ''))}</option>`).join('');
    if (cur) sel.value = cur;
  }
  // список мастеров для отправки tx: свои + обнаруженные вне панели
  const box = document.getElementById('wal-masters');
  if (box) {
    const urls = walletMasters();
    box.innerHTML = urls.length
      ? urls.map((u) => `<span class="chip">${esc(u)}</span>`).join('')
      : '<span class="muted">мастера не найдены — запустите мастера на вкладке «Мастер»</span>';
  }
}

/* ==================== настройки (src/config.json) ==================== */

// Эти ключи в настройках мастера не показываем
const HIDDEN_IN_MASTER = ['port', 'coinbase_confirmations'];

function configField(key, entry) {
  const wrapped = entry && typeof entry === 'object' && 'value' in entry;
  const value = wrapped ? entry.value : entry;
  const help = wrapped ? (entry.help || '') : '';
  const wide = (value !== null && typeof value === 'object') ? ' wide' : '';
  let control;
  if (typeof value === 'boolean') {
    control = `<label class="cfg-bool"><input type="checkbox" data-key="${esc(key)}" data-type="bool" ${value ? 'checked' : ''}/></label>`;
  } else if (typeof value === 'number') {
    control = `<input type="number" step="any" data-key="${esc(key)}" data-type="number" value="${value}" />`;
  } else if (typeof value === 'string') {
    control = `<input type="text" data-key="${esc(key)}" data-type="string" value="${esc(value)}" />`;
  } else {
    control = `<textarea data-key="${esc(key)}" data-type="json">${esc(JSON.stringify(value, null, 2))}</textarea>`;
  }
  return `<div class="cfg-field${wide}"><label>${esc(key)}</label>${control}`
    + (help ? `<div class="muted">${esc(help)}</div>` : '') + '</div>';
}

async function loadConfigForm(which) {
  const box = document.getElementById('cfg-' + which);
  const msg = document.getElementById('cfg-' + which + '-msg');
  if (!box) return;
  box.innerHTML = '<span class="muted">читаю…</span>';
  const data = await api('/api/config');
  if (!data.ok) {
    box.innerHTML = `<span class="err">${esc(data.error || 'config.json не читается')}</span>`;
    return;
  }
  const cfg = data.config || {};
  box.dataset.json = JSON.stringify(cfg);
  const keys = Object.keys(cfg).filter((k) => !HIDDEN_IN_MASTER.includes(k));
  box.innerHTML = keys.map((k) => configField(k, cfg[k])).join('')
    || '<span class="muted">нет полей</span>';
  if (msg) msg.textContent = '';
}

async function saveConfigForm(which) {
  const box = document.getElementById('cfg-' + which);
  const msg = document.getElementById('cfg-' + which + '-msg');
  const outgoing = {};
  for (const el of box.querySelectorAll('[data-key]')) {
    const key = el.dataset.key;
    const type = el.dataset.type;
    let value;
    if (type === 'bool') {
      value = el.checked;
    } else if (type === 'number') {
      value = Number(el.value);
      if (!Number.isFinite(value)) {
        msg.innerHTML = `<span class="err">${esc(key)}: нужно число</span>`;
        return;
      }
    } else if (type === 'json') {
      try {
        value = JSON.parse(el.value);
      } catch (e) {
        msg.innerHTML = `<span class="err">${esc(key)}: некорректный JSON</span>`;
        return;
      }
    } else {
      value = el.value;
    }
    outgoing[key] = { value };
  }
  msg.textContent = 'сохраняю…';
  const r = await api('/api/config', { config: outgoing });
  if (r.ok) {
    msg.innerHTML = '<span class="ok">сохранено — применится при следующем запуске</span>';
    if (box.dataset.json) box.dataset.json = JSON.stringify(r.config || {});
  } else {
    msg.innerHTML = `<span class="err">${esc(r.error || 'не сохранилось')}</span>`;
  }
}

['master'].forEach((which) => {
  const details = document.getElementById('cfg-' + which + '-box');
  if (!details) return;
  details.addEventListener('toggle', () => {
    if (details.open) loadConfigForm(which);
  });
  document.getElementById('cfg-' + which + '-reload')
    .addEventListener('click', () => loadConfigForm(which));
  document.getElementById('cfg-' + which + '-save')
    .addEventListener('click', () => saveConfigForm(which));
});

/* ==================== инициализация ==================== */

buildWalletTab();

const _origFillDirs = fillDirSelects;
fillDirSelects = function (dirs) {
  _origFillDirs(dirs);
};

refreshOverview().then(() => {
  fillWalletRoots(overview.dirs);
  $('#wal-root').value = overview.dirs[0] || '';
  refreshChains();
  refreshWalletNames(['wal-name'], $('#wal-root').value || null);
  refreshWalletNames(['m-wallet', 'w-wallet'], null);
});

// подсказываем порт мастера из настроек (config.json → port)
api('/api/config').then((d) => {
  if (!d.ok) return;
  const p = d.config.port;
  const v = (p && typeof p === 'object' && 'value' in p) ? p.value : p;
  if (v) $('#m-port').placeholder = `${v} (из настроек)`;
});
refreshNetwork();

// Кошелёк — независимый клиент: пока вкладка открыта, он сам периодически
// опрашивает известных мастеров (балансы, подтверждения, мемпул).
setInterval(() => {
  if (activeTab === 'wallet' && walletState) refreshWallet();
}, 5000);

// список мастеров тоже обновляем — адреса могут появиться через gossip
setInterval(() => {
  if (activeTab === 'worker' || activeTab.startsWith('wallet')) refreshNetwork();
}, 15000);
</script>
