              <div style="flex:0 0 auto"><button class="btn secondary" id="${tab}-chpass">Сменить</button></div>
            </div>
            <p class="muted">Нужно указать новый пароль для единственного кошелька,
            который подходит под текущий (иначе — роль/имя через CLI).</p>
          </details>
        </div>

        <div class="card" id="${tab}-send-card" style="display:none">
          <h2>Перевести монеты</h2>
          <div class="row">
            <div><label>Адрес получателя</label><input type="text" id="${tab}-to" /></div>
            <div><label>Сумма</label><input type="number" id="${tab}-amount" step="0.1" min="0" /></div>
            <div><label>Комиссия</label><input type="number" id="${tab}-fee" step="0.01" value="0.1" /></div>
            <div><label>Мастер</label><select id="${tab}-master"></select></div>
          </div>
          <div class="actions">
            <button class="btn" id="${tab}-send">Отправить</button>
            <span class="muted" id="${tab}-send-msg"></span>
          </div>
        </div>
      </div>

      <div>
        <div class="card">
          <h2>Содержимое</h2>
          <div id="${tab}-content" class="muted">нажмите «Открыть»</div>
        </div>

        <div class="card" id="${tab}-tx-card" style="display:none">
          <h2>Транзакция</h2>
          <div id="${tab}-tx"></div>
        </div>
      </div>
    </div>`;

  document.getElementById(tab + '-open').addEventListener('click', async () => {
    const password = document.getElementById(tab + '-password').value;
    const root = document.getElementById(tab + '-root').value;
    wallets[tab].password = password;
    const msg = document.getElementById(tab + '-msg');
    msg.textContent = 'читаю…';
    const data = await api('/api/wallet/info', {
      password, resultsRoot: root || null, role: isMaster ? 'master' : 'worker',
    });
    if (!data.ok) {
      msg.innerHTML = `<span class="err">${esc(data.error || 'ошибка')}</span>`;
      document.getElementById(tab + '-content').innerHTML =
