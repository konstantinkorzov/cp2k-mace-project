<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Смена пароля — CP2K + MACE</title>
<style>
  :root { --bg:#f4f6f9; --card:#fff; --line:#dfe4ea; --ink:#1f2933; --muted:#6b7785;
          --accent:#2b6cb0; --red:#c53030; --green:#2f855a; }
  * { box-sizing: border-box; }
  body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center;
         background:var(--bg); color:var(--ink);
         font:14px/1.45 -apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif; }
  form { width:360px; background:var(--card); border:1px solid var(--line); border-radius:10px;
         padding:22px; box-shadow:0 2px 10px rgba(16,24,40,.06); }
  h1 { font-size:16px; margin:0 0 14px; }
  label { display:block; font-size:12px; color:var(--muted); margin:10px 0 4px; }
  input { width:100%; padding:9px 10px; border:1px solid var(--line); border-radius:8px;
          font:inherit; background:#fff; }
  button { margin-top:14px; width:100%; padding:9px 12px; border:0; border-radius:8px;
           background:var(--accent); color:#fff; font:inherit; cursor:pointer; }
  .err { background:#fff5f5; border:1px solid #fed7d7; color:var(--red);
         border-radius:8px; padding:8px 10px; font-size:12.5px; margin-bottom:6px; }
  .ok { background:#f0fff4; border:1px solid #c6f6d5; color:var(--green);
        border-radius:8px; padding:8px 10px; font-size:12.5px; margin-bottom:6px; }
  .muted { color:var(--muted); font-size:12px; margin-top:14px; text-align:center; }
  a { color:var(--accent); }
</style>
</head>
<body>
<form method="post" action="/password">
  <h1>Смена пароля панели</h1>
  <% if (error) { %><div class="err"><%= error %></div><% } %>
  <% if (ok) { %><div class="ok"><%= ok %></div><% } %>
  <label>Текущий пароль</label>
  <input type="password" name="old_password" autocomplete="current-password" required />
  <label>Новый пароль (минимум 8 символов)</label>
  <input type="password" name="new_password" autocomplete="new-password" minlength="8" required />
  <label>Новый пароль ещё раз</label>
  <input type="password" name="confirm_password" autocomplete="new-password" minlength="8" required />
  <button type="submit">Сменить пароль</button>
  <p class="muted"><a href="/">← вернуться в панель</a> · <a href="/logout">выйти</a></p>
</form>
</body>
</html>
